# Copy this file to `.env` and fill in only the credentials needed by the implementation.
# Never commit the real `.env` file.

# Phase 5B defaults use separate Research Agent and Evidence Verifier models.
L3S_LLM_PROVIDER=openai
L3S_LLM_TEXT_MODEL=gpt-5.6-terra
L3S_LLM_VERIFIER_MODEL=gpt-4.1-2025-04-14
L3S_LLM_MULTIMODAL_MODEL=
L3S_LLM_TIMEOUT_SECONDS=60
L3S_LLM_MAX_RETRIES=0
L3S_LLM_MAX_CONTEXT_CHARACTERS=200000
L3S_LLM_ACTION_EVIDENCE_PREVIEW_CHARACTERS=600
L3S_LLM_TEMPERATURE=
L3S_LLM_REASONING_EFFORT=

# Required only for separately approved production LLM runs.
OPENAI_API_KEY=

# Phase 4 local dense-retrieval model and verified immutable revision. Dense
# indexing defaults to the local model cache only.
L3S_EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
L3S_EMBEDDING_REVISION=e7f32e3c00f91d699e8c43b53106206bcc72bb22
L3S_EMBEDDING_LOCAL_ONLY=true
L3S_EMBEDDING_TRUST_REMOTE_CODE=false

# Optional contact email for polite scientific-API usage where supported
OPENALEX_EMAIL=

# Required for live Phase 2 OpenAlex requests. Obtain a free key from OpenAlex.
# Never print or commit the real value.
OPENALEX_API_KEY=

# The ML dataset remains unapproved and must not be configured yet.
L3S_ML_DATASET_APPROVED=false

# Add further credentials only when they become necessary.
# Example:
# SEMANTIC_SCHOLAR_API_KEY=
