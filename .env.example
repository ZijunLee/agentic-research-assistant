# Copy this file to `.env` and fill in only the credentials needed by the implementation.
# Never commit the real `.env` file.

# One configurable LLM provider supplies text, verification, structured output,
# and multimodal inspection. Values remain unset until a provider is selected.
L3S_LLM_PROVIDER=
L3S_LLM_TEXT_MODEL=
L3S_LLM_VERIFIER_MODEL=
L3S_LLM_MULTIMODAL_MODEL=

# Add the selected provider credential only when the provider is approved.
# EXAMPLE_PROVIDER_API_KEY=

# Local sentence-transformers model; intentionally unset in Phase 1.
L3S_EMBEDDING_MODEL=
L3S_EMBEDDING_LOCAL_ONLY=true

# Optional contact email for polite scientific-API usage where supported
OPENALEX_EMAIL=

# Required for live Phase 2 OpenAlex requests. Obtain a free key from OpenAlex.
# Never print or commit the real value.
OPENALEX_API_KEY=

# The ML dataset remains unapproved and must not be configured yet.
L3S_ML_DATASET_APPROVED=false

# Add further credentials only when they become necessary.
# Example:
# SEMANTIC_SCHOLAR_API_KEY=
